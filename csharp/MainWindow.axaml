<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="UFeelTest.MainWindow"
    Width="1280"
    Height="850"
    MinWidth="900"
    MinHeight="600"
    Title="UFeel Integration Test"
    Background="#F4F6F8"
    Foreground="#17202A">

    <Window.Resources>
        <ControlTheme x:Key="IntegrationButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="#E7EDF4" />
            <Setter Property="Foreground" Value="#17202A" />
            <Setter Property="BorderBrush" Value="#AAB7C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter
                        x:Name="PART_ContentPresenter"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}"
                        RecognizesAccessKey="True" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#D8E2ED" />
                <Setter Property="Foreground" Value="#17202A" />
                <Setter Property="BorderBrush" Value="#71869B" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#C7D5E3" />
                <Setter Property="Foreground" Value="#17202A" />
                <Setter Property="BorderBrush" Value="#536B82" />
            </Style>
            <Style Selector="^:focus">
                <Setter Property="BorderBrush" Value="#005A9E" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="#E7EDF4" />
                <Setter Property="Foreground" Value="#687785" />
                <Setter Property="BorderBrush" Value="#AAB7C4" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Grid>
        <Grid RowDefinitions="*,Auto" Margin="16">
            <Grid ColumnDefinitions="*,320" ColumnSpacing="16">
                <Border
                    Grid.Column="0"
                    Background="#171B22"
                    CornerRadius="10"
                    Padding="8">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock
                            Text="Camera"
                            Foreground="#FFFFFF"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="8,4,8,12" />
                        <Border
                            Grid.Row="1"
                            Background="#0E1116"
                            CornerRadius="6"
                            ClipToBounds="True">
                            <Image
                                x:Name="FrameImage"
                                Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer
                    Grid.Column="1"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Border
                            Background="#FFFFFF"
                            CornerRadius="10"
                            Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Emotions"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="EmotionsText"
                                    Text="Waiting for data..."
                                    TextWrapping="Wrap"
                                    FontFamily="Monospace" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#FFFFFF"
                            CornerRadius="10"
                            Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Eye tracking"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="DirectionsText"
                                    Text="Waiting for data..."
                                    TextWrapping="Wrap"
                                    FontFamily="Monospace" />
                                <TextBlock
                                    x:Name="GazeText"
                                    Text="Calibrate to estimate gaze"
                                    TextWrapping="Wrap"
                                    FontFamily="Monospace" />
                                <TextBlock
                                    Text="Position is relative to this window. Maximize before calibration for a larger area."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#FFFFFF"
                            CornerRadius="10"
                            Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Speech recognition"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="SpeechText"
                                    Text="Speech disabled"
                                    TextWrapping="Wrap"
                                    MinHeight="48" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border
                Grid.Row="1"
                Background="#FFFFFF"
                CornerRadius="10"
                Padding="12"
                Margin="0,16,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock
                        x:Name="StatusText"
                        Text="Ready"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        x:Name="SpeechButton"
                        Theme="{StaticResource IntegrationButtonTheme}"
                        Content="Enable speech"
                        Click="SpeechButton_OnClick"
                        Padding="16,8" />
                    <Button
                        Grid.Column="2"
                        x:Name="CalibrateButton"
                        Theme="{StaticResource IntegrationButtonTheme}"
                        Content="Calibrate / recalibrate"
                        Click="CalibrateButton_OnClick"
                        Padding="16,8" />
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="GazeOverlay"
            IsVisible="False"
            IsHitTestVisible="False">
            <Canvas x:Name="GazeCanvas">
                <Ellipse
                    x:Name="GazeMarker"
                    Width="24"
                    Height="24"
                    Fill="#F2C94C"
                    Stroke="#17202A"
                    StrokeThickness="3" />
            </Canvas>
        </Grid>

        <Grid
            x:Name="CalibrationOverlay"
            IsVisible="False"
            Background="#E6171B22">
            <Canvas
                x:Name="CalibrationCanvas"
                Background="Transparent">
                <Ellipse
                    x:Name="CalibrationMarker"
                    Width="28"
                    Height="28"
                    Fill="#35D07F"
                    Stroke="#FFFFFF"
                    StrokeThickness="3" />
            </Canvas>
            <TextBlock
                x:Name="CalibrationInstruction"
                Text="Look at the target, keep your face steady and eyes open"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,36,0,0"
                Foreground="#FFFFFF"
                FontSize="20"
                FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>
