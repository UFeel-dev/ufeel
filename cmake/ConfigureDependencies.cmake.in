set(PATCHELF_EXECUTABLE "@PATCHELF_EXECUTABLE@")
set(PACKAGE_DIR "${CMAKE_INSTALL_PREFIX}")
set(DEPENDENCIES_DIR "${PACKAGE_DIR}/dependencies")

if(NOT EXISTS "${PATCHELF_EXECUTABLE}")
    message(FATAL_ERROR "patchelf not found: ${PATCHELF_EXECUTABLE}")
endif()

if(NOT EXISTS "${PACKAGE_DIR}/libufeel_wrapper.so")
    message(FATAL_ERROR "Installed wrapper not found")
endif()

if(NOT IS_DIRECTORY "${DEPENDENCIES_DIR}")
    message(FATAL_ERROR "Dependencies directory not found")
endif()

execute_process(
    COMMAND "${PATCHELF_EXECUTABLE}"
        --set-rpath "$ORIGIN/dependencies"
        "${PACKAGE_DIR}/libufeel_wrapper.so"
    RESULT_VARIABLE RESULT
    ERROR_VARIABLE PATCHELF_ERROR
)

if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR
        "Failed to set wrapper RUNPATH: ${PATCHELF_ERROR}"
    )
endif()

file(GLOB BUNDLED_LIBS
    "${DEPENDENCIES_DIR}/*.so"
    "${DEPENDENCIES_DIR}/*.so.*"
)

foreach(LIB IN LISTS BUNDLED_LIBS)
    if(NOT IS_SYMLINK "${LIB}")
        execute_process(
            COMMAND "${PATCHELF_EXECUTABLE}"
                --set-rpath "$ORIGIN" "${LIB}"
            RESULT_VARIABLE RESULT
            ERROR_VARIABLE PATCHELF_ERROR
        )

        if(NOT RESULT EQUAL 0)
            message(FATAL_ERROR
                "Failed to set RUNPATH on ${LIB}: ${PATCHELF_ERROR}"
            )
        endif()
    endif()
endforeach()

file(GLOB OPENCV_LIBS
    "${DEPENDENCIES_DIR}/libopencv_*.so.4.8.1"
)

foreach(LIB IN LISTS OPENCV_LIBS)
    get_filename_component(NAME "${LIB}" NAME)
    string(REGEX REPLACE "\\.so\\.4\\.8\\.1$" ".so.408" SONAME "${NAME}")

    file(REMOVE "${DEPENDENCIES_DIR}/${SONAME}")

    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E create_symlink
            "${NAME}"
            "${DEPENDENCIES_DIR}/${SONAME}"
        RESULT_VARIABLE RESULT
    )

    if(NOT RESULT EQUAL 0)
        message(FATAL_ERROR "Failed to create symlink for ${LIB}")
    endif()
endforeach()

file(REMOVE "${DEPENDENCIES_DIR}/libportaudio.so.2")

execute_process(
    COMMAND "${CMAKE_COMMAND}" -E create_symlink
        libportaudio.so.2.0.0
        "${DEPENDENCIES_DIR}/libportaudio.so.2"
    RESULT_VARIABLE RESULT
)

if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "Failed to create PortAudio symlink")
endif()

if(NOT EXISTS "${DEPENDENCIES_DIR}/libyaml-cpp.so.0.7")
    message(FATAL_ERROR "Bundled yaml-cpp SONAME symlink is missing")
endif()
