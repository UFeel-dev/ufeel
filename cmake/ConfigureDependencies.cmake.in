set(PATCHELF_EXECUTABLE "@PATCHELF_EXECUTABLE@")
set(PACKAGE_DIR "${CMAKE_INSTALL_PREFIX}")
set(DEPENDENCIES_DIR "${PACKAGE_DIR}/dependencies")

if(NOT EXISTS "${PATCHELF_EXECUTABLE}")
    message(FATAL_ERROR "patchelf not found: ${PATCHELF_EXECUTABLE}")
endif()

if(NOT EXISTS "${PACKAGE_DIR}/libufeel_wrapper.so")
    message(FATAL_ERROR "Installed wrapper not found")
endif()

if(NOT IS_DIRECTORY "${DEPENDENCIES_DIR}")
    message(FATAL_ERROR "Dependencies directory not found")
endif()

execute_process(
    COMMAND "${PATCHELF_EXECUTABLE}"
        --set-rpath "$ORIGIN/dependencies"
        "${PACKAGE_DIR}/libufeel_wrapper.so"
    RESULT_VARIABLE RESULT
    ERROR_VARIABLE PATCHELF_ERROR
)

if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR
        "Failed to set wrapper RUNPATH: ${PATCHELF_ERROR}"
    )
endif()

file(GLOB BUNDLED_LIBS
    "${DEPENDENCIES_DIR}/*.so"
    "${DEPENDENCIES_DIR}/*.so.*"
)

foreach(LIB IN LISTS BUNDLED_LIBS)
    if(NOT IS_SYMLINK "${LIB}")
        execute_process(
            COMMAND "${PATCHELF_EXECUTABLE}"
                --set-rpath "$ORIGIN" "${LIB}"
            RESULT_VARIABLE RESULT
            ERROR_VARIABLE PATCHELF_ERROR
        )

        if(NOT RESULT EQUAL 0)
            message(FATAL_ERROR
                "Failed to set RUNPATH on ${LIB}: ${PATCHELF_ERROR}"
            )
        endif()
    endif()
endforeach()

if(@UFEEL_ENABLE_HEART_RATE@)
    file(GET_RUNTIME_DEPENDENCIES
        RESOLVED_DEPENDENCIES_VAR CURL_DEPENDENCIES
        UNRESOLVED_DEPENDENCIES_VAR CURL_UNRESOLVED
        LIBRARIES "${DEPENDENCIES_DIR}/libcurl.so.4"
        DIRECTORIES "${DEPENDENCIES_DIR}"
    )

    foreach(DEPENDENCY IN LISTS CURL_DEPENDENCIES)
        get_filename_component(NAME "${DEPENDENCY}" NAME)
        if(NOT NAME MATCHES "^(ld-linux|libc|libm|libdl|libpthread|librt|libgcc_s|libstdc\\+\\+|linux-vdso)")
            file(COPY "${DEPENDENCY}" DESTINATION "${DEPENDENCIES_DIR}"
                FOLLOW_SYMLINK_CHAIN)
        endif()
    endforeach()

    file(GLOB CURL_BUNDLED_LIBS
        "${DEPENDENCIES_DIR}/*.so"
        "${DEPENDENCIES_DIR}/*.so.*"
    )
    foreach(LIB IN LISTS CURL_BUNDLED_LIBS)
        if(NOT IS_SYMLINK "${LIB}")
            execute_process(
                COMMAND "${PATCHELF_EXECUTABLE}"
                    --set-rpath "$ORIGIN" "${LIB}"
                RESULT_VARIABLE RESULT
                ERROR_VARIABLE PATCHELF_ERROR
            )
            if(NOT RESULT EQUAL 0)
                message(FATAL_ERROR
                    "Failed to set curl dependency RUNPATH: ${PATCHELF_ERROR}"
                )
            endif()
        endif()
    endforeach()
endif()

if(@UFEEL_ENABLE_EMOTIONS@ AND
   NOT EXISTS "${DEPENDENCIES_DIR}/libyaml-cpp.so.0.7")
    message(FATAL_ERROR "Bundled yaml-cpp SONAME file is missing")
endif()

if(@UFEEL_ENABLE_EMOTIONS@ AND
   NOT EXISTS "${DEPENDENCIES_DIR}/libgomp-98b21ff3.so.1")
    message(FATAL_ERROR "Bundled libgomp SONAME file is missing")
endif()

if(@UFEEL_ENABLE_SPEECH_TO_TEXT@ AND
   NOT EXISTS "${DEPENDENCIES_DIR}/libportaudio.so.2")
    message(FATAL_ERROR "Bundled PortAudio SONAME file is missing")
endif()

if(@UFEEL_ENABLE_HEART_RATE@ AND
   NOT EXISTS "${DEPENDENCIES_DIR}/libcurl.so.4")
    message(FATAL_ERROR "Bundled curl SONAME file is missing")
endif()
